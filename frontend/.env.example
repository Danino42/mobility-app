# URL of the deployed FastAPI backend (Render). Leave unset for local dev (uses Vite proxy).
VITE_API_BASE_URL=https://your-backend.onrender.com

# Google Maps JavaScript API key. Create one at https://console.cloud.google.com/google/maps-apis
# Enable "Maps JavaScript API" for the project, then restrict the key to your
# domains (localhost:5173 for dev, your Vercel domain for prod).
VITE_GOOGLE_MAPS_API_KEY=your-api-key-here
